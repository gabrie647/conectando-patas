# Modelo de variáveis de ambiente. Copie para o painel do Render. Nunca suba o .env real.

# E-mails dos administradores, separados por vírgula.
ADMIN_EMAILS=

# production ou development.
APP_ENV=

# Texto longo e aleatório para o hash de IP nos limites de tentativas.
APP_SALT=

# Endereço público do site, sem barra final. Usado nos links de e-mail.
APP_URL=

# Use 1 só se o site for acessado somente pelo domínio do Cloudflare.
CLOUDFLARE=

# E-mail que recebe as mensagens do formulário de contato.
CONTACT_NOTIFY_EMAIL=

# Conexão com o PostgreSQL (obrigatória). Ex.: postgres://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL=

# Remetente dos e-mails. Ex.: Conectando Patas <nao-responda@seudominio.com>
MAIL_FROM=

# Proxies na frente do site (Render = 1; acesso direto = 0).
PROXY_HOPS=

# Chave da API de e-mail (Resend). Sem ela, não há confirmação de e-mail.
RESEND_API_KEY=

# Publicação automática na página pública de animais.
# Padrão: ativada. Configure AUTO_APROVAR=0 somente se quiser voltar à aprovação manual.
AUTO_APROVAR=1

