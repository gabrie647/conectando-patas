# Exemplo apenas para desenvolvimento local; troque a senha antes de usar.
POSTGRES_USER=conectando_patas_db_user
POSTGRES_PASSWORD=troque_esta_senha_local
DATABASE_URL=postgresql://conectando_patas_db_user:troque_esta_senha_local@db:5432/conectando_patas_db?sslmode=disable

# E-mails (separados por vírgula) que podem abrir o painel em /admin/
ADMIN_EMAILS=seu-email@exemplo.com
# Endereço público do site (usado no link do e-mail de nova senha)
APP_URL=http://localhost:8080
# Qualquer texto aleatório; deixa o hash dos IPs mais seguro
APP_SALT=troque_por_um_texto_aleatorio
# Opcional: envio de e-mails pelo Resend (recuperar senha e aviso de contato)
RESEND_API_KEY=
MAIL_FROM=
CONTACT_NOTIFY_EMAIL=
